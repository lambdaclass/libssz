# libssz (Rust) ≡ EthLib (Lean), via Charon + Aeneas.
#
#   make extract         regenerates every Aeneas model below from ../crates
#   make extract-codec   lean/Libssz/Code/             from ../crates/ssz
#   make extract-merkle  lean/Libssz/Merkle/Code/      the SHA-NI kernel (src/shani.rs), the
#                        tree (src/lib.rs) and the example containers (src/verif_example.rs)
#                        of ../crates/ssz-merkle
#   make extract-neon    lean/Libssz/MerkleNeon/Code/  the AArch64 SHA-256 kernel
#                        (../crates/ssz-merkle/src/neon.rs); compiled for
#                        aarch64-unknown-linux-gnu, no ARM machine needed
#   make extract-types   lean/Libssz/SszTypes/Code/    from ../crates/ssz-types
#   make proofs          builds the proofs and prints the axioms of the main theorems
#   make difftest        differential tests: the Lean model and EthLib against the Rust code,
#                        and the CPU's SHA instructions and the SHA-NI kernel against their
#                        Lean models
#
# Tools: Charon and Aeneas at the commits in README.md, and Lean through elan.

CHARON ?= charon
AENEAS ?= aeneas

# The x86-64 extractions (codec, SHA-NI kernel and tree, types) are compiled for this target,
# whatever the host: `src/shani.rs` only exists on x86-64.
X86 := x86_64-unknown-linux-gnu

CRATE_CODEC  := ../crates/ssz
CRATE_MERKLE := ../crates/ssz-merkle
CRATE_TYPES  := ../crates/ssz-types
# The containers in `verif_example.rs` are generated by the derive macro, so a change in it
# changes the code extracted from all three crates.
DERIVE       := $(wildcard ../crates/ssz-derive/src/*.rs)

LLBC_CODEC  := $(abspath libssz.llbc)
LLBC_MERKLE := $(abspath libssz-merkle-shani.llbc)
LLBC_NEON   := $(abspath libssz-merkle-neon.llbc)
LLBC_TYPES  := $(abspath libssz-types.llbc)

CODE_CODEC  := lean/Libssz/Code
CODE_MERKLE := lean/Libssz/Merkle/Code
CODE_NEON   := lean/Libssz/MerkleNeon/Code
CODE_TYPES  := lean/Libssz/SszTypes/Code

AENEAS_FLAGS := -backend lean -dest lean -split-files -loops-to-rec -all-computable

.PHONY: extract extract-codec extract-merkle extract-neon extract-types proofs difftest clean

extract: extract-codec extract-merkle extract-neon extract-types

$(LLBC_CODEC): $(wildcard $(CRATE_CODEC)/src/*.rs) $(CRATE_CODEC)/Cargo.toml $(DERIVE) Makefile
	cd $(CRATE_CODEC) && $(CHARON) cargo --preset=aeneas --dest-file=$(LLBC_CODEC) \
	  -- --features verif-example --target $(X86)

# The SHA-NI kernel's entry points are listed explicitly: `available` (CPU feature detection)
# stays opaque, and the rest of the crate is reached from the tree functions.
$(LLBC_MERKLE): $(wildcard $(CRATE_MERKLE)/src/*.rs) $(CRATE_MERKLE)/Cargo.toml $(DERIVE) Makefile
	cd $(CRATE_MERKLE) && $(CHARON) cargo --preset=aeneas \
	  --start-from crate::shani::hash_pair --start-from crate::shani::hash_pairs_x2 \
	  --start-from crate::shani::hash_pairs_x4 \
	  --start-from crate::shani::hash_layer --opaque crate::shani::available \
	  --start-from crate::merkleize --start-from crate::merkleize_in_place \
	  --start-from crate::merkleize_groups --start-from crate::hash_tree_roots \
	  --start-from crate::pack --start-from crate::pack_bits \
	  --start-from crate::mix_in_length --start-from crate::mix_in_selector \
	  --start-from crate::merkleize_progressive \
	  --start-from crate::verif_example \
	  --dest-file=$(LLBC_MERKLE) -- --features verif-example --target $(X86)

$(LLBC_NEON): $(wildcard $(CRATE_MERKLE)/src/*.rs) $(CRATE_MERKLE)/Cargo.toml Makefile
	cd $(CRATE_MERKLE) && $(CHARON) cargo --preset=aeneas \
	  --start-from crate::neon::hash_pair --start-from crate::neon::hash_pairs_x2 \
	  --start-from crate::neon::hash_pairs_x4 --start-from crate::neon::hash_layer \
	  --opaque crate::neon::available \
	  --dest-file=$(LLBC_NEON) -- --target aarch64-unknown-linux-gnu

$(LLBC_TYPES): $(wildcard $(CRATE_TYPES)/src/*.rs) $(CRATE_TYPES)/Cargo.toml $(DERIVE) Makefile
	cd $(CRATE_TYPES) && $(CHARON) cargo --preset=aeneas --start-from crate::verif_example \
	  --dest-file=$(LLBC_TYPES) -- --features verif-example --target $(X86)

extract-codec: $(LLBC_CODEC)
	$(AENEAS) $(AENEAS_FLAGS) $(LLBC_CODEC) -subdir /Libssz/Code -namespace libssz_codec \
	  -filter-trait-methods
	python3 -I scripts/complete_externals_codec.py \
	  $(CODE_CODEC)/FunsExternal_Template.lean $(CODE_CODEC)/FunsExternal.lean
	rm -f $(CODE_CODEC)/FunsExternal_Template.lean

# The SHA-NI kernel uses eight intrinsics from `core::arch::x86_64`, the `__m128i` type and
# `black_box`. Aeneas leaves them external; scripts/complete_externals_merkle.py plugs in the
# hand-written models from lean/Libssz/Merkle/Intrinsics.lean (and fails if any other axiom
# appears). This is the technique of gattaca-com/silver. `pack` also uses `as_chunks`, which
# gets the same model as in the codec (lean/Libssz/StdModel.lean).
extract-merkle: $(LLBC_MERKLE)
	$(AENEAS) $(AENEAS_FLAGS) $(LLBC_MERKLE) -subdir /Libssz/Merkle/Code \
	  -namespace libssz_merkle -filter-trait-methods
	python3 -I scripts/complete_externals_merkle.py $(CODE_MERKLE)

# The AArch64 kernel uses eight intrinsics from `core::arch::aarch64`, the `uint32x4_t` type
# and `black_box`. scripts/complete_externals_neon.py plugs in the hand-written models from
# lean/Libssz/MerkleNeon/Intrinsics.lean (and fails if any other axiom appears); `black_box`
# is the one from the x86 extraction.
extract-neon: $(LLBC_NEON)
	$(AENEAS) $(AENEAS_FLAGS) $(LLBC_NEON) -subdir /Libssz/MerkleNeon/Code \
	  -namespace libssz_merkle
	python3 -I scripts/complete_externals_neon.py $(CODE_NEON)

extract-types: $(LLBC_TYPES)
	$(AENEAS) $(AENEAS_FLAGS) $(LLBC_TYPES) -subdir /Libssz/SszTypes/Code \
	  -namespace libssz_types -filter-trait-methods
	python3 -I scripts/complete_externals_types.py $(CODE_TYPES)

# Fails if any main theorem uses `sorry` or an axiom other than Lean's standard ones.
proofs:
	cd lean && lake build && lake env lean Axioms.lean 2>&1 | python3 -I ../scripts/check_axioms.py Axioms.lean

# difftest/ runs the Lean model of the codec and EthLib against the Rust code. difftest-merkle/
# compares the CPU's real intrinsics with their Lean models, and the SHA-NI kernel with its
# Aeneas model, with EthLib and with the `sha2` crate (x86-64 with the SHA extensions only).
difftest:
	cd lean && lake build difftest difftest-merkle
	cd difftest && cargo test --release -- --nocapture --test-threads 1
	cd difftest-merkle && cargo test --release -- --nocapture --test-threads 1

clean:
	rm -f $(LLBC_CODEC) $(LLBC_MERKLE) $(LLBC_NEON) $(LLBC_TYPES)
