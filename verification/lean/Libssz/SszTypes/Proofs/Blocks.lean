      inst x h ⦃ r => hashTreeRoot (.container ethNames (ethFields)) (ethV x) = .ok (bytes r.val) ⦄ := by
  unfold libssz_types.verif_example.Eth1Data.Insts.Libssz_merkleHashTreeRoot.hash_tree_root
  simp only [libssz_types.ArrayU8N.Insts.Libssz_merkleHashTreeRoot.hash_tree_root,
    libssz_types.U64.Insts.Libssz_merkleHashTreeRoot.hash_tree_root,
    libssz_types.libssz_merkle.merkleize_in_place]
  step with ArrayU8N.hash_tree_root.spec inst h hl x.deposit_root as ⟨ a0, h0 ⟩
  step with U64.hash_tree_root.spec inst h x.deposit_count as ⟨ a1, h1 ⟩
  step with ArrayU8N.hash_tree_root.spec inst h hl x.block_hash as ⟨ a2, h2 ⟩
  simp only [lift, bind_ok, Array.to_slice_mut]
  step with merkleize_in_place.spec inst h hl _ none (by simp) as ⟨ r, rest, hr, _ ⟩
  unfold ethV
  rw [hashTreeRoot_container _ _ _ [bytes a0.val, bytes a1.val, bytes a2.val] rfl
    (by simp only [ethFields] at *; simp [h0, h1, h2, Pure.pure, Except.pure, Bind.bind, Except.bind])]
  have hc : chunksOf (Array.make 3#usize [a0, a1, a2] (by simp)).to_slice.val =
      #[bytes a0.val, bytes a1.val, bytes a2.val] := by simp [chunksOf, Array.to_slice]
  simp only [hc, Option.map_none] at hr
  rw [show (ethFields).length = (#[bytes a0.val, bytes a1.val, bytes a2.val]).size from rfl, merkleizeBounded_some_self, ← hr]

