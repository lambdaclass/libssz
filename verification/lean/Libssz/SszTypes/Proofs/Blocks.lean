/-- **`BeaconBlockBody`** (phase0, with the mainnet sizes. Requires the invariants of its lists and of their contents): the `hash_tree_root` the macro generates is EthLib's. -/
theorem BeaconBlockBody.hash_tree_root.spec (x : libssz_types.verif_example.BeaconBlockBody)
    (hps : x.proposer_slashings.length ≤ 16) (has : x.attester_slashings.length ≤ 2)
    (has' : ∀ s ∈ x.attester_slashings.val,
      s.attestation_1.attesting_indices.length ≤ 2048 ∧ s.attestation_2.attesting_indices.length ≤ 2048)
    (hatt : x.attestations.length ≤ 128) (hatt' : ∀ a ∈ x.attestations.val, BlInv a.aggregation_bits)
    (hdep : x.deposits.length ≤ 16) (hdep' : ∀ d ∈ x.deposits.val, d.proof.length = 33)
    (hve : x.voluntary_exits.length ≤ 16) :
    libssz_types.verif_example.BeaconBlockBody.Insts.Libssz_merkleHashTreeRoot.hash_tree_root
      inst x h ⦃ r => hashTreeRoot (.container bodyNames (bodyFields)) (bodyV x) = .ok (bytes r.val) ⦄ := by
  unfold libssz_types.verif_example.BeaconBlockBody.Insts.Libssz_merkleHashTreeRoot.hash_tree_root
  simp only [libssz_types.ArrayU8N.Insts.Libssz_merkleHashTreeRoot.hash_tree_root,
    libssz_types.libssz_merkle.merkleize_in_place]
  step with ArrayU8N.hash_tree_root.spec inst h hl x.randao_reveal as ⟨ a0, h0 ⟩
  step with Eth1Data.hash_tree_root.spec inst h hl x.eth1_data as ⟨ a1, h1 ⟩
  step with ArrayU8N.hash_tree_root.spec inst h hl x.graffiti as ⟨ a2, h2 ⟩
  step with SszList.composite_root inst h hl
      libssz_types.verif_example.ProposerSlashing.Insts.Libssz_merkleHashTreeRoot
      libssz_types.verif_example.ProposerSlashing.Insts.LibsszEncodeSszEncode rfl
      (.container psNames psFields) rfl psV _ _ (ProposerSlashing.rows inst h hl)
      x.proposer_slashings hps (fun y hy => trivial) as ⟨ a3, h3 ⟩
  step with SszList.composite_root inst h hl
      libssz_types.verif_example.AttesterSlashing.Insts.Libssz_merkleHashTreeRoot
      libssz_types.verif_example.AttesterSlashing.Insts.LibsszEncodeSszEncode rfl
      (.container asNames asFields) rfl asV _ _ (AttesterSlashing.rows inst h hl)
      x.attester_slashings has (fun y hy => has' y hy) as ⟨ a4, h4 ⟩
  step with SszList.composite_root inst h hl
      libssz_types.verif_example.Attestation.Insts.Libssz_merkleHashTreeRoot
      libssz_types.verif_example.Attestation.Insts.LibsszEncodeSszEncode rfl
      (.container attNames attFields) rfl attV _ _ (Attestation.rows inst h hl)
      x.attestations hatt (fun y hy => hatt' y hy) as ⟨ a5, h5 ⟩
  step with SszList.composite_root inst h hl
      libssz_types.verif_example.Deposit.Insts.Libssz_merkleHashTreeRoot
      libssz_types.verif_example.Deposit.Insts.LibsszEncodeSszEncode rfl
      (.container depNames depFields) rfl depV _ _ (Deposit.rows inst h hl)
      x.deposits hdep (fun y hy => hdep' y hy) as ⟨ a6, h6 ⟩
  step with SszList.composite_root inst h hl
      libssz_types.verif_example.SignedVoluntaryExit.Insts.Libssz_merkleHashTreeRoot
      libssz_types.verif_example.SignedVoluntaryExit.Insts.LibsszEncodeSszEncode rfl
      (.container sveNames sveFields) rfl sveV _ _ (SignedVoluntaryExit.rows inst h hl)
      x.voluntary_exits hve (fun y hy => trivial) as ⟨ a7, h7 ⟩
  simp only [lift, bind_ok, Array.to_slice_mut]
  step with merkleize_in_place.spec inst h hl _ none (by simp) as ⟨ r, rest, hr, _ ⟩
  unfold bodyV
  rw [hashTreeRoot_container _ _ _ [bytes a0.val, bytes a1.val, bytes a2.val, bytes a3.val, bytes a4.val, bytes a5.val, bytes a6.val, bytes a7.val] rfl
    (by simp only [bodyFields] at *; simp [h0, h1, h2, h3, h4, h5, h6, h7, Pure.pure, Except.pure, Bind.bind, Except.bind])]
  have hc : chunksOf (Array.make 8#usize [a0, a1, a2, a3, a4, a5, a6, a7] (by simp)).to_slice.val =
      #[bytes a0.val, bytes a1.val, bytes a2.val, bytes a3.val, bytes a4.val, bytes a5.val, bytes a6.val, bytes a7.val] := by simp [chunksOf, Array.to_slice]
  simp only [hc, Option.map_none] at hr
  rw [show (bodyFields).length = (#[bytes a0.val, bytes a1.val, bytes a2.val, bytes a3.val, bytes a4.val, bytes a5.val, bytes a6.val, bytes a7.val]).size from rfl, merkleizeBounded_some_self, ← hr]

