include hl in
/-- **`BeaconState`** (phase0, with `VALIDATOR_REGISTRY_LIMIT` as a parameter (`VRL`). Requires the invariants of its lists, vectors and bitfields, and that `8 · VRL` fit in a `usize` (on mainnet, 2^43)): the `hash_tree_root` the macro generates is EthLib's. -/
theorem BeaconState.hash_tree_root.spec {VRL : Std.Usize} (x : (libssz_types.verif_example.BeaconState VRL))
    (hvrl : 8 * VRL.val ≤ Usize.max)
    (hbr : x.block_roots.length = 8192) (hsr : x.state_roots.length = 8192)
    (hhr : x.historical_roots.length ≤ 16777216) (hev : x.eth1_data_votes.length ≤ 2048)
    (hval : x.validators.length ≤ VRL.val) (hbal : x.balances.length ≤ VRL.val)
    (hrm : x.randao_mixes.length = 65536) (hsl : x.slashings.length = 8192)
    (hpa : x.previous_epoch_attestations.length ≤ 4096)
    (hpa' : ∀ a ∈ x.previous_epoch_attestations.val, BlInv a.aggregation_bits)
    (hca : x.current_epoch_attestations.length ≤ 4096)
    (hca' : ∀ a ∈ x.current_epoch_attestations.val, BlInv a.aggregation_bits)
    (hjb : Canon (bytes x.justification_bits.bytes.val) 4) :
    libssz_types.verif_example.BeaconState.Insts.Libssz_merkleHashTreeRoot.hash_tree_root
      inst x h ⦃ r => hashTreeRoot (.container stateNames (stateFields VRL)) (stateV x) = .ok (bytes r.val) ⦄ := by
  unfold libssz_types.verif_example.BeaconState.Insts.Libssz_merkleHashTreeRoot.hash_tree_root
  simp only [libssz_types.ArrayU8N.Insts.Libssz_merkleHashTreeRoot.hash_tree_root,
    libssz_types.U64.Insts.Libssz_merkleHashTreeRoot.hash_tree_root,
    libssz_types.libssz_merkle.verif_example.BeaconBlockHeader.Insts.Libssz_merkleHashTreeRoot.hash_tree_root,
    libssz_types.libssz_merkle.verif_example.Checkpoint.Insts.Libssz_merkleHashTreeRoot.hash_tree_root,
    libssz_types.libssz_merkle.verif_example.Fork.Insts.Libssz_merkleHashTreeRoot.hash_tree_root,
    libssz_types.libssz_merkle.merkleize_in_place]
  step with U64.hash_tree_root.spec inst h x.genesis_time as ⟨ a0, h0 ⟩
  step with ArrayU8N.hash_tree_root.spec inst h hl x.genesis_validators_root as ⟨ a1, h1 ⟩
  step with U64.hash_tree_root.spec inst h x.slot as ⟨ a2, h2 ⟩
  step with Fork.hash_tree_root.spec inst h hl x.fork as ⟨ a3, h3 ⟩
  step with BeaconBlockHeader.hash_tree_root.spec inst h hl x.latest_block_header as ⟨ a4, h4 ⟩
  step with SszVectorBytes32.hash_tree_root.spec inst h hl x.block_roots hbr (by scalar_tac) as ⟨ a5, h5 ⟩
  step with SszVectorBytes32.hash_tree_root.spec inst h hl x.state_roots hsr (by scalar_tac) as ⟨ a6, h6 ⟩
  step with SszListBytes32.hash_tree_root.spec inst h hl x.historical_roots hhr (by scalar_tac) as ⟨ a7, h7 ⟩
  step with Eth1Data.hash_tree_root.spec inst h hl x.eth1_data as ⟨ a8, h8 ⟩
  step with SszList.composite_root inst h hl
      libssz_types.verif_example.Eth1Data.Insts.Libssz_merkleHashTreeRoot
      libssz_types.verif_example.Eth1Data.Insts.LibsszEncodeSszEncode rfl
      (.container ethNames ethFields) rfl ethV _ _ (Eth1Data.rows inst h hl)
      x.eth1_data_votes hev (fun y hy => trivial) as ⟨ a9, h9 ⟩
  step with U64.hash_tree_root.spec inst h x.eth1_deposit_index as ⟨ a10, h10 ⟩
  step with SszListValidator.hash_tree_root.spec inst h hl _ x.validators hval as ⟨ a11, h11 ⟩
  step with SszListU64.hash_tree_root.spec inst h hl x.balances hbal hvrl as ⟨ a12, h12 ⟩
  step with SszVectorBytes32.hash_tree_root.spec inst h hl x.randao_mixes hrm (by scalar_tac) as ⟨ a13, h13 ⟩
  step with SszVectorU64.hash_tree_root.spec inst h hl x.slashings hsl (by scalar_tac) as ⟨ a14, h14 ⟩
  step with SszList.composite_root inst h hl
      libssz_types.verif_example.PendingAttestation.Insts.Libssz_merkleHashTreeRoot
      libssz_types.verif_example.PendingAttestation.Insts.LibsszEncodeSszEncode rfl
      (.container paNames paFields) rfl paV _ _ (PendingAttestation.rows inst h hl)
      x.previous_epoch_attestations hpa (fun y hy => hpa' y hy) as ⟨ a15, h15 ⟩
  step with SszList.composite_root inst h hl
      libssz_types.verif_example.PendingAttestation.Insts.Libssz_merkleHashTreeRoot
      libssz_types.verif_example.PendingAttestation.Insts.LibsszEncodeSszEncode rfl
      (.container paNames paFields) rfl paV _ _ (PendingAttestation.rows inst h hl)
      x.current_epoch_attestations hca (fun y hy => hca' y hy) as ⟨ a16, h16 ⟩
  step with SszBitvector.hash_tree_root.spec inst h hl x.justification_bits hjb as ⟨ a17, h17 ⟩
  step with Checkpoint.hash_tree_root.spec inst h hl x.previous_justified_checkpoint as ⟨ a18, h18 ⟩
  step with Checkpoint.hash_tree_root.spec inst h hl x.current_justified_checkpoint as ⟨ a19, h19 ⟩
  step with Checkpoint.hash_tree_root.spec inst h hl x.finalized_checkpoint as ⟨ a20, h20 ⟩
  simp only [lift, bind_ok, Array.to_slice_mut]
  step with merkleize_in_place.spec inst h hl _ none (by simp) as ⟨ r, rest, hr, _ ⟩
  unfold stateV bytesSeqV uintSeqV bvV
  rw [hashTreeRoot_container _ _ _ [bytes a0.val, bytes a1.val, bytes a2.val, bytes a3.val, bytes a4.val, bytes a5.val, bytes a6.val, bytes a7.val, bytes a8.val, bytes a9.val, bytes a10.val, bytes a11.val, bytes a12.val, bytes a13.val, bytes a14.val, bytes a15.val, bytes a16.val, bytes a17.val, bytes a18.val, bytes a19.val, bytes a20.val] rfl
    (by simp only [stateFields] at *; simp [h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19, h20, Pure.pure, Except.pure, Bind.bind, Except.bind])]
  have hc : chunksOf (Array.make 21#usize [a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20] (by simp)).to_slice.val =
      #[bytes a0.val, bytes a1.val, bytes a2.val, bytes a3.val, bytes a4.val, bytes a5.val, bytes a6.val, bytes a7.val, bytes a8.val, bytes a9.val, bytes a10.val, bytes a11.val, bytes a12.val, bytes a13.val, bytes a14.val, bytes a15.val, bytes a16.val, bytes a17.val, bytes a18.val, bytes a19.val, bytes a20.val] := by simp [chunksOf, Array.to_slice]
  simp only [hc, Option.map_none] at hr
  rw [show (stateFields VRL).length = (#[bytes a0.val, bytes a1.val, bytes a2.val, bytes a3.val, bytes a4.val, bytes a5.val, bytes a6.val, bytes a7.val, bytes a8.val, bytes a9.val, bytes a10.val, bytes a11.val, bytes a12.val, bytes a13.val, bytes a14.val, bytes a15.val, bytes a16.val, bytes a17.val, bytes a18.val, bytes a19.val, bytes a20.val]).size from rfl, merkleizeBounded_some_self, ← hr]

