  have hc : chunksOf (Array.make 5#usize [a0, a1, a2, a3, a4] (by simp)).to_slice.val =
      #[bytes a0.val, bytes a1.val, bytes a2.val, bytes a3.val, bytes a4.val] := by simp [chunksOf, Array.to_slice]
