  have hc : chunksOf (Array.make 2#usize [a0, a1] (by simp)).to_slice.val =
      #[bytes a0.val, bytes a1.val] := by simp [chunksOf, Array.to_slice]
  simp only [hc, Option.map_none] at hr
  rw [show (sveFields).length = (#[bytes a0.val, bytes a1.val]).size from rfl, merkleizeBounded_some_self, ← hr]

include hl in
/-- **The rows of `SignedVoluntaryExit`**: the roots of its 2 fields, the bottom level
of its tree. -/
theorem SignedVoluntaryExit.rows :
    Rows inst h libssz_types.verif_example.SignedVoluntaryExit.Insts.Libssz_merkleHashTreeRoot (.container sveNames sveFields) sveV
      (fun x => True) 1 where
  small := by omega
  width := ⟨ 2#usize, rfl, rfl ⟩
  row x row hgood hlen := by
    simp only [libssz_types.verif_example.SignedVoluntaryExit.Insts.Libssz_merkleHashTreeRoot]
    unfold libssz_types.verif_example.SignedVoluntaryExit.Insts.Libssz_merkleHashTreeRoot.hash_tree_root_row
    simp only [libssz_types.ArrayU8N.Insts.Libssz_merkleHashTreeRoot.hash_tree_root]
    have hlen' : row.val.length = 2 := hlen
    obtain ⟨ b0, b1, hrowv ⟩ := list_len2 row.val hlen'
    step with VoluntaryExit.hash_tree_root.spec inst h hl x.message as ⟨ a0, h0 ⟩
    step as ⟨ row1, hrow1 ⟩
    have hl1 : row1.length = 2 := by
      rw [hrow1]; simp only [Slice.length, Slice.set_val_eq, List.length_set]; exact hlen
    step with ArrayU8N.hash_tree_root.spec inst h hl x.signature as ⟨ a1, h1 ⟩
    step as ⟨ row2, hrow2 ⟩
    have hl2 : row2.length = 2 := by
      rw [hrow2]; simp only [Slice.length, Slice.set_val_eq, List.length_set]; exact hl1
    have hrv : row2.val = [a0, a1] := by
      rw [hrow2, hrow1]
      simp only [Slice.set_val_eq, hrowv]
      rfl
    refine ⟨ by simp [Slice.length, hrv], ?_ ⟩
    unfold RowRoot sveV
    rw [hashTreeRoot_container _ _ _ [bytes a0.val, bytes a1.val] rfl
      (by simp only [sveFields] at *; simp [h0, h1, Pure.pure, Except.pure, Bind.bind, Except.bind])]
    rw [hrv]
    exact container_row_root [a0, a1] 1 (by simp [depthFor])

