/-- **`Checkpoint`**: the `hash_tree_root` generated by the macro is the EthLib one. -/
theorem Checkpoint.hash_tree_root.spec (c : verif_example.Checkpoint) :
    verif_example.Checkpoint.Insts.Libssz_merkleHashTreeRoot.hash_tree_root inst c h ⦃ r =>
      hashTreeRoot (.container Proofs.cpNames Proofs.cpFields) (cpV c) = .ok (bytes r.val) ⦄ := by
  unfold verif_example.Checkpoint.Insts.Libssz_merkleHashTreeRoot.hash_tree_root
  step with U64.hash_tree_root.spec inst h c.epoch as ⟨ a0, h0 ⟩
  step with ArrayU8N.hash_tree_root.spec inst h hl c.root as ⟨ a1, h1 ⟩
  simp only [lift, bind_ok, Array.to_slice_mut]
  step with merkleize_in_place.spec inst h hl _ none (by simp) as ⟨ r, rest, hr, _ ⟩
  have h1' : hashTreeRoot (.byteVector 32) (.bytes (bytes c.root.val)) = .ok (bytes a1.val) := h1
  unfold cpV
  rw [hashTreeRoot_container _ _ _ [bytes a0.val, bytes a1.val] rfl
    (by simp [Proofs.cpFields, h0, h1', Pure.pure, Except.pure, Bind.bind, Except.bind])]
  have hc : chunksOf (Array.make 2#usize [a0, a1] (by simp)).to_slice.val =
      #[bytes a0.val, bytes a1.val] := by simp [chunksOf, Array.to_slice]
  simp only [hc, Option.map_none] at hr
  rw [show Proofs.cpFields.length = (#[bytes a0.val, bytes a1.val]).size from rfl,
    merkleizeBounded_some_self, ← hr]

