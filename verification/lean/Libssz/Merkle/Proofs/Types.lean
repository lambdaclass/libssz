@[expose] public section

/-!
# The `hash_tree_root` of each type

For the basic types (`bool`, `u8`…`u128`), for `[u8; N]` and for the containers generated by
`#[derive(HashTreeRoot)]`: the `hash_tree_root` of `ssz-merkle` is EthLib's `hashTreeRoot`
(`EthLib/Serialization/Ssz/Codec/Root.lean`), with the corresponding type descriptor.
-/

open Aeneas Aeneas.Std Result
open libssz_merkle
open Libssz.Proofs (byte bytes)
open EthLib.Serialization.Ssz

namespace Libssz.Merkle

/-! ## EthLib: the root of a single-leaf value -/

/-- `packBytes` of between 1 and 32 bytes: a single node, padded with zeros. -/
theorem packBytes_one (data : Bytes) (h1 : 0 < data.size) (h2 : data.size ≤ 32) :
    packBytes data = #[data ++ Array.replicate (32 - data.size) 0] := by
  apply Array.ext
  · simp [packBytes, bytesPerChunk]; omega
  · intro i hi1 hi2
    have hi : i = 0 := by simp at hi2; omega
    subst hi
    have he : data.extract 0 32 = data := by
      apply Array.toList_inj.mp
      simp [List.take_of_length_le (show data.toList.length ≤ 32 by simpa using h2)]
    simp [packBytes, bytesPerChunk, he, Nat.min_eq_right h2]

/-- **The root of a single-leaf value** (`bool` and the integers): its encoding, padded with
zeros to 32 bytes. -/
theorem hashTreeRoot_leaf (shape : Desc) (value : Value) (enc : Bytes)
    (hnest : shape.nesting = 1)
    (hlayout : merkleLayout shape value = fixedLeaf shape value)
    (hser : serialize shape value = .ok enc) (h1 : 0 < enc.size) (h2 : enc.size ≤ 32) :
    hashTreeRoot shape value = .ok (enc ++ Array.replicate (32 - enc.size) 0) := by
  rw [hashTreeRoot_eq_nesting, hnest, hashTreeRootAt_succ, hlayout]
  simp [fixedLeaf, hser, packBytes_one enc h1 h2, layoutChunksAt_eq, MerkleLayout.packing,
    Leaves.count, merkleizeBoundedUnchecked_eq, depthFor_one, subtreeAt_leaf, Bind.bind,
    Except.bind, Pure.pure, Except.pure]

/-! ## The integers and `bool` -/

/-- The bytes of an array written at the start of a zero node. -/
theorem prefix_node (l : List Std.U8) (back : Slice Std.U8 → Std.Array Std.U8 32#usize)
    (hback : ∀ s', (back s').val = (List.replicate 32 0#u8).setSlice! 0 s'.val)
    (s : Slice Std.U8) (hs : s.val = l) (hl : l.length ≤ 32) :
    bytes (back s).val = bytes l ++ Array.replicate (32 - l.length) 0 := by
  rw [hback s, hs, setSlice!_zero_replicate _ _ _ hl, Libssz.Proofs.bytes_append]
  congr 1
  simp [bytes]
  exact Or.inr rfl

/-- **`u64`**: the `hash_tree_root` is the EthLib one for `uint64`. -/
theorem U64.hash_tree_root.spec {H : Type} (inst : Sha256Hasher H) (h : H) (x : Std.U64) :
    U64.Insts.Libssz_merkleHashTreeRoot.hash_tree_root inst x h ⦃ r =>
      hashTreeRoot Desc.uint64 (.uint x.val) = .ok (bytes r.val) ⦄ := by
  unfold U64.Insts.Libssz_merkleHashTreeRoot.hash_tree_root
  simp only [lift, bind_ok]
  step as ⟨ s1, back, hs1, hs1len, hback ⟩
  step as ⟨ s3, hs3 ⟩
  have hb : ∀ s', (back s').val = (List.replicate 32 0#u8).setSlice! 0 s'.val := by
    intro s'; rw [hback, Array.repeat_val]; rfl
  rw [prefix_node (core.num.U64.to_le_bytes x).val back hb s3
      (by rw [hs3]; simp [Array.to_slice]) (by simp),
    hashTreeRoot_leaf Desc.uint64 (.uint x.val) (uintBytes 8 x.val) rfl rfl
      (by simp [serialize, Desc.uint64]; scalar_tac) (by simp [uintBytes_size])
      (by simp [uintBytes_size]),
    U64.bytes_to_le, uintBytes_size]
  simp

/-- `u8::to_le_bytes`, as EthLib bytes. -/
theorem U8.bytes_to_le (x : Std.U8) :
    bytes (core.num.U8.to_le_bytes x).val = uintBytes 1 x.val := by
  have h := core.num.U8.to_le_bytes.step_spec x
  simp only [lift, WP.spec_ok] at h
  rw [h, Libssz.Proofs.bytes_toLEBytes 1 x.bv (by rfl)]
  rfl

