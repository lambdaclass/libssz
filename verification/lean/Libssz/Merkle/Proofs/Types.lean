/-! ## `[u8; N]` -/

/-- **The root of a byte vector** according to EthLib: the tree of its packed nodes, with
capacity equal to the number of nodes. -/
theorem hashTreeRoot_byteVector (data : Bytes) :
    hashTreeRoot (.byteVector data.size) (.bytes data) =
      .ok (subtreeAt (packBytes data) (depthFor (packBytes data).size) 0) := by
  rw [hashTreeRoot_eq_nesting, show (Desc.byteVector data.size).nesting = 1 from rfl,
    hashTreeRootAt_succ]
  have hps : (data.size + 31) / bytesPerChunk = (packBytes data).size := by simp [packBytes]
  simp [merkleLayout, layoutChunksAt_eq, MerkleLayout.packing, Leaves.count,
    merkleizeBoundedUnchecked_eq, Bind.bind, Except.bind, Pure.pure, Except.pure]
  rw [hps, Array.extract_size]

/-- Without a limit, the specification uses the depth of the nodes. -/
theorem merkleizeBounded_none (chunks : Array Bytes) :
    merkleizeBoundedUnchecked chunks none = .ok (subtreeAt chunks (depthFor chunks.size) 0) := by
  rw [merkleizeBoundedUnchecked_eq]; rfl

/-- The zero node, as a Rust array. -/
abbrev zeroNode : Node := Array.repeat 32#usize 0#u8

section Bytes

variable {H : Type} (inst : Sha256Hasher H) (h : H) (hl : Lawful inst h)

include hl in
/-- The end of the 33-to-256-byte path: the first `⌈N / 32⌉` nodes of the stack array,
merkleized without a limit. -/
theorem u8n_tail {N : Std.Usize} (x : Std.Array Std.U8 N) (hN : N.val ≤ 256)
    (chunks1 : Std.Array (Std.Array Std.U8 32#usize) 8#usize)
    (hc : chunksOf (chunks1.val.take ((N.val + 31) / 32)) = packBytes (bytes x.val)) :
    (do
      let i1 ← core.num.Usize.div_ceil N 32#usize
      let (s3, _) ←
        core.array.Array.index_mut (core.ops.index.IndexMutSlice
          (core.slice.index.SliceIndexRangeToUsizeSlice (Std.Array Std.U8 32#usize)))
          chunks1 { «end» := i1 }
      let (node, _) ← merkleize_in_place inst h s3 none
      ok node) ⦃ r =>
      (Except.ok (subtreeAt (packBytes (bytes x.val)) (depthFor (packBytes (bytes x.val)).size) 0)
        : Except Err Bytes) = Except.ok (bytes r.val) ⦄ := by
  step as ⟨ i1, hi1 ⟩
  have hi1' : i1.val = (N.val + 31) / 32 := by
    rw [hi1, Nat.ceilDiv_eq_add_pred_div]; omega
  step as ⟨ s3, back3, hs3, hs3len, hback3 ⟩
  step with merkleize_in_place.spec inst h hl s3 none (by simp) as ⟨ node, rest, hnode, hrest ⟩
  simp only [Option.map_none] at hnode
  rw [merkleizeBounded_none] at hnode
  have hs3v : s3.val = chunks1.val.take ((N.val + 31) / 32) := by
    rw [hs3, List.slice, List.drop_zero, Nat.sub_zero, hi1']
  rw [hs3v, hc] at hnode
  exact hnode

include hl in
/-- **`[u8; N]`**: the `hash_tree_root` is the EthLib one for `ByteVector[N]`. Up to 32 bytes
the node is the array padded with zeros; up to 256, the tree of its nodes is built on a stack
array; beyond that, on `pack`. -/
theorem ArrayU8N.hash_tree_root.spec {N : Std.Usize} (x : Std.Array Std.U8 N) :
    ArrayU8N.Insts.Libssz_merkleHashTreeRoot.hash_tree_root inst x h ⦃ r =>
      hashTreeRoot (.byteVector N.val) (.bytes (bytes x.val)) = .ok (bytes r.val) ⦄ := by
  have hsz : (bytes x.val).size = N.val := by simp
  rw [← hsz, hashTreeRoot_byteVector]
  unfold ArrayU8N.Insts.Libssz_merkleHashTreeRoot.hash_tree_root
  spec_split
  · rename_i h32
    have hN : N.val ≤ 32 := by scalar_tac
    step as ⟨ s, back, hs, hslen, hback ⟩
    simp only [lift, bind_ok]
    step as ⟨ s2, hs2 ⟩
    have hb : ∀ s', (back s').val = (List.replicate 32 0#u8).setSlice! 0 s'.val := by
      intro s'; rw [hback, Array.repeat_val]; rfl
    rw [prefix_node x.val back hb s2 (by rw [hs2]; simp [Array.to_slice]) (by simp; omega)]
    by_cases h0 : N.val = 0
    · have hnil : x.val = [] := List.eq_nil_of_length_eq_zero (by simp [h0])
      have hp : packBytes (bytes x.val) = #[] := by
        apply Array.ext <;> simp [packBytes, hnil, bytes, bytesPerChunk]
      rw [hp, subtreeAt_past _ _ _ (by simp), zeroSubtree_eq, Array.size_empty, depthFor_zero]
      simp [hnil, bytes, zeroRoot, zeroChunk, bytesPerChunk]
    · rw [packBytes_one _ (by simp; omega) (by simp; omega)]
      simp [depthFor_one, subtreeAt_leaf]
  · spec_split
    · rename_i h32 h256
      simp only [lift, bind_ok]
      have hN : 32 < N.val ∧ N.val ≤ 256 := ⟨ by scalar_tac, by scalar_tac ⟩
      step with as_chunks32.spec (Array.to_slice x) as ⟨ whole, rest, hw, hr ⟩
      have hxs : (Array.to_slice x).val = x.val := by simp [Array.to_slice]
      have hxl : (Array.to_slice x).length = N.val := by simp [Array.to_slice]
      rw [hxs, hxl] at hw hr
      have hwl : whole.length = N.val / 32 := by
        have := congrArg List.length hw; simpa using this
      have hxlen : x.val.length = N.val := by simp
      have hrl : rest.length = N.val % 32 := by
        simp only [Slice.length, hr, List.length_drop, hxlen]
        have := Nat.div_add_mod N.val 32
        omega
      step as ⟨ s1, back, hs1, hs1len, hback ⟩
      step as ⟨ s2, hs2 ⟩
      have hzero : (Array.repeat 8#usize (Array.repeat 32#usize 0#u8)).val =
          List.replicate 8 zeroNode := Array.repeat_val _ _
      have hle : whole.val.length ≤ 8 := by
        have h8 := hwl
        simp only [Slice.length] at h8
        omega
      have hb2 : (back s2).val = whole.val ++ List.replicate (8 - whole.val.length) zeroNode := by
        rw [hback, hzero, hs2, setSlice!_zero_replicate _ _ _ hle]
      step as ⟨ b, hb ⟩
      split
      · rename_i hbt
        have h0 : N.val % 32 = 0 := by
          have : rest.length = 0 := by rw [← hb]; exact hbt
          omega
        simp only [bind_ok]
        apply u8n_tail inst h hl x hN.2 (back s2)
        rw [hb2, show (N.val + 31) / 32 = whole.length by omega, List.take_left' rfl]
        rw [← List.append_nil whole.val]
        exact packBytes_eq x.val whole.val [] (by rw [hxlen]; exact hw)
          (Or.inl ⟨ by rw [hxlen]; exact h0, rfl ⟩)
      · rename_i hbf
        have h0 : N.val % 32 ≠ 0 := fun h0 => hbf (by rw [hb]; omega)
        have hk8 : whole.val.length < 8 := by
          have h8 := hwl
          simp only [Slice.length] at h8
          omega
        apply WP.spec_bind (Pₘ := fun chunks1 : Std.Array (Std.Array Std.U8 32#usize) 8#usize =>
          chunksOf (chunks1.val.take ((N.val + 31) / 32)) = packBytes (bytes x.val))
        · step as ⟨ a1, back1, ha1, hback1 ⟩
          step as ⟨ s3, back2, hs3, hs3len, hback2 ⟩
          step as ⟨ s4, hs4 ⟩
          have hk : whole.len.val = whole.val.length := by simp
          have ha1v : a1.val = List.replicate 32 0#u8 := by
            rw [ha1]
            simp [hb2, hk, zeroNode, Array.repeat_val]
          have hlv : (back2 s4).val = rest.val ++ List.replicate (32 - rest.val.length) 0#u8 := by
            rw [hback2, hs4, ha1v, setSlice!_zero_replicate _ _ _ (by
              have h9 := hrl; simp only [Slice.length] at h9; omega)]
          have hchunks : (back1 (back2 s4)).val =
              whole.val ++ back2 s4 :: List.replicate (8 - whole.val.length - 1) zeroNode := by
            rw [hback1, Array.set_val_eq, hb2, hk,
              show 8 - whole.val.length = (8 - whole.val.length - 1) + 1 by omega,
              List.replicate_succ, List.set_append_right _ _ (by omega)]
            simp
          have hkk : (N.val + 31) / 32 = whole.val.length + 1 := by
            have h8 := hwl; simp only [Slice.length] at h8; omega
          rw [hchunks, hkk, List.take_append, List.take_of_length_le (by omega)]
          simp only [Nat.add_sub_cancel_left, List.take_succ_cons, List.take_zero]
          apply packBytes_eq x.val whole.val [back2 s4] (by rw [hxlen]; exact hw)
          refine Or.inr ⟨ by rw [hxlen]; exact h0, back2 s4, rfl, ?_ ⟩
          rw [hlv, hr, hxlen]
          congr 2
          simp only [List.length_drop, hxlen]
          have := Nat.div_add_mod N.val 32
          omega
        · intro chunks1 hc
          exact u8n_tail inst h hl x hN.2 chunks1 hc
    · simp only [lift, bind_ok]
      step with pack.spec (Array.to_slice x) as ⟨ v, hv ⟩
      simp only [alloc.vec.Vec.deref_mut]
      step with merkleize_in_place.spec inst h hl v.slice none (by simp)
        as ⟨ node, rest, hnode, hrest ⟩
      have hv' : chunksOf v.val = packBytes (bytes x.val) := by simpa [Array.to_slice] using hv
      simp only [Option.map_none] at hnode
      rw [merkleizeBounded_none] at hnode
      have hvs : (v.slice).val = v.val := rfl
      rw [hvs, hv'] at hnode
      exact hnode

end Bytes

/-! ## Containers -/

theorem nesting_le_deepest (fields : List Desc) (d : Desc) (h : d ∈ fields) :
    d.nesting ≤ Desc.deepestNesting fields := by
  induction fields with
  | nil => simp at h
  | cons f rest ih =>
    rw [Desc.deepestNesting]
    rcases List.mem_cons.mp h with rfl | h'
    · exact Nat.le_max_left _ _
    · exact Nat.le_trans (ih h') (Nat.le_max_right _ _)

theorem mapM_congr {α β : Type} (f g : α → Except Err β) (xs : List α)
    (same : ∀ x ∈ xs, f x = g x) : xs.mapM f = xs.mapM g := by
  induction xs with
  | nil => rfl
  | cons x xs ih =>
    simp only [List.mapM_cons, same x (by simp), ih (fun y hy => same y (by simp [hy]))]

/-- **The root of a container** according to EthLib: the tree of the roots of its fields,
with capacity equal to the number of fields. -/
theorem hashTreeRoot_container (names : List String) (fields : List Desc) (values : List Value)
    (roots : List Bytes) (hlen : fields.length = values.length)
    (hroots : (fields.zip values).mapM (fun p => hashTreeRoot p.1 p.2) = .ok roots) :
    hashTreeRoot (.container names fields) (.seq values) =
      merkleizeBoundedUnchecked roots.toArray (some fields.length) := by
  rw [hashTreeRoot_eq_nesting, show (Desc.container names fields).nesting =
    Desc.deepestNesting fields + 1 from rfl, hashTreeRootAt_succ]
  have hlay : merkleLayout (.container names fields) (.seq values) =
      .ok (MerkleLayout.nesting ((fields.zip values).map some) (some fields.length)) := by
    simp [merkleLayout, hlen, Pure.pure, Except.pure]
  have hchunks : layoutChunksAt (Desc.deepestNesting fields)
      (MerkleLayout.nesting ((fields.zip values).map some) (some fields.length)) =
      .ok roots.toArray := by
    simp only [layoutChunksAt_eq, MerkleLayout.nesting, Leaves.count, Option.getD_none,
      List.drop_zero, Nat.sub_zero, List.take_length]
    rw [List.mapM_map]
    rw [mapM_congr _ (fun p => hashTreeRoot p.1 p.2) _ (by
      intro ⟨ d, v ⟩ hp
      show hashTreeRootAt _ d v = hashTreeRoot d v
      exact hashTreeRootAt_eq_hashTreeRoot _ _ _
        (nesting_le_deepest fields d (List.of_mem_zip hp).1)), hroots]
    rfl
  simp only [hlay, Bind.bind, Except.bind]
  rw [hchunks]
  simp only [MerkleLayout.nesting]
  cases merkleizeBoundedUnchecked roots.toArray (some fields.length) <;> rfl

/-- With capacity equal to the number of nodes, the tree is the same as without a limit. -/
theorem merkleizeBounded_some_self (X : Array Bytes) :
    merkleizeBoundedUnchecked X (some X.size) = merkleizeBoundedUnchecked X none := by
  rw [merkleizeBoundedUnchecked_eq, merkleizeBoundedUnchecked_eq]
  simp

/-! ### The containers of `verif_example.rs`

The type descriptors are those of `Libssz/Proofs/FixedContainers.lean`: the root is compared
against the same EthLib type as the encoding. -/

def cpV (c : verif_example.Checkpoint) : Value :=
  .seq [.uint c.epoch.val, .bytes (bytes c.root.val)]

/-- The fields of `Uints`, which is not from the consensus layer. -/
def uintsNames : List String := ["a", "b", "c", "d"]
def uintsFields : List Desc := [Desc.uint8, Desc.uint16, Desc.uint32, Desc.uint128]

def forkV (x : verif_example.Fork) : Value :=
  .seq [.bytes (bytes x.previous_version.val), .bytes (bytes x.current_version.val), .uint x.epoch.val]

def bbhV (x : verif_example.BeaconBlockHeader) : Value :=
  .seq [.uint x.slot.val, .uint x.proposer_index.val, .bytes (bytes x.parent_root.val), .bytes (bytes x.state_root.val), .bytes (bytes x.body_root.val)]

def valV (x : verif_example.Validator) : Value :=
  .seq [.bytes (bytes x.pubkey.val), .bytes (bytes x.withdrawal_credentials.val), .uint x.effective_balance.val, .bool x.slashed, .uint x.activation_eligibility_epoch.val, .uint x.activation_epoch.val, .uint x.exit_epoch.val, .uint x.withdrawable_epoch.val]

def adV (x : verif_example.AttestationData) : Value :=
  .seq [.uint x.slot.val, .uint x.index.val, .bytes (bytes x.beacon_block_root.val), cpV x.source, cpV x.target]

def uintsV (x : verif_example.Uints) : Value :=
  .seq [.uint x.a.val, .uint x.b.val, .uint x.c.val, .uint x.d.val]

