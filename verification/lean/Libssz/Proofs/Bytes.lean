module
public import Aeneas
public import EthLib.Serialization.Proofs.Ssz.Codec.Uint
@[expose] public section

/-!
# Rust bytes as EthLib bytes

Basic translations shared by all the proofs: they do not depend on the code generated by
Aeneas.

| Rust (Aeneas model)                 | EthLib                 |
|-------------------------------------|------------------------|
| `Std.U8` (with `bv : BitVec 8`)     | `UInt8`                |
| `List Std.U8` (from `Vec`/`Slice`)  | `Bytes = Array UInt8`  |
| `Std.U64`, …                        | `Value.uint (n : Nat)` |

`byte` and `bytes` are part of the trusted base: they appear in the statements. The rest are
lemmas: the two little-endian arithmetics (Aeneas and EthLib) compute the same thing, and a
spec of `extend_from_slice` that the Aeneas library does not provide.
-/

open Aeneas Aeneas.Std Result
open EthLib.Serialization.Ssz

namespace Libssz.Proofs

/-! ## Translations -/

/-- A Rust byte as an EthLib byte: the same 8 bits. -/
def byte (b : Std.U8) : UInt8 := UInt8.ofBitVec b.bv

/-- Rust bytes (the contents of a `Vec<u8>` or `&[u8]`) as EthLib `Bytes`. -/
def bytes (l : List Std.U8) : Bytes := (l.map byte).toArray

/-! ## Lemmas about the translations -/

@[simp] theorem byte_toNat (b : Std.U8) : (byte b).toNat = b.val := rfl

@[simp] theorem bytes_size (l : List Std.U8) : (bytes l).size = l.length := by
  simp [bytes]

@[simp] theorem bytes_append (l₁ l₂ : List Std.U8) :
    bytes (l₁ ++ l₂) = bytes l₁ ++ bytes l₂ := by
  simp [bytes]

@[simp] theorem bytes_cons (b : Std.U8) (l : List Std.U8) :
    bytes (b :: l) = #[byte b] ++ bytes l := by
  simp [bytes]

/-! ## A spec missing from the Aeneas library -/

/-- `Vec<u8>::extend_from_slice` appends the bytes at the end (if it does not exceed
`usize::MAX`). -/
@[step]
theorem extend_from_slice_u8_spec (v : alloc.vec.Vec Std.U8) (s : Slice Std.U8)
    (h : v.length + s.length ≤ Usize.max) :
    alloc.vec.Vec.extend_from_slice core.clone.CloneU8 v s ⦃ v' => v'.val = v.val ++ s.val ⦄ := by
  unfold alloc.vec.Vec.extend_from_slice
  simp only [h, ↓reduceDIte]
  step with List.clone_spec (fun _ _ => rfl) as ⟨ s', hs', _ ⟩
  simp [hs']

/-! ## Little-endian: the Aeneas side against the EthLib side -/

/-- Reading little-endian bytes as a number, in `Nat`: `b₀ + 256·(b₁ + 256·(…))`. -/
def leValue {β : Type} (toNat : β → Nat) (l : List β) : Nat :=
  l.foldr (fun b acc => toNat b + 256 * acc) 0

/-- The Aeneas decoder (`BitVec.fromLEBytes`, used by `uN::from_le_bytes`) computes
`leValue`. -/
theorem toNat_fromLEBytes (l : List Byte) :
    (BitVec.fromLEBytes l).toNat = leValue BitVec.toNat l := by
  induction l with
  | nil => simp [BitVec.fromLEBytes, leValue]
  | cons b l ih =>
    have hb := b.isLt
    have hl := (BitVec.fromLEBytes l).isLt
    have hc : 1 ≤ 2 ^ (8 * l.length) := Nat.one_le_two_pow
    rw [ih] at hl
    rw [BitVec.fromLEBytes]
    simp only [BitVec.toNat_or, BitVec.toNat_shiftLeft, BitVec.toNat_setWidth, ih, List.length_cons]
    simp only [leValue, List.foldr_cons] at *
    generalize List.foldr (fun b acc => BitVec.toNat b + 256 * acc) 0 l = a at *
    -- `b ||| (a <<< 8)` is `b + 256·a` because `b < 256`, and nothing is truncated.
    have hP : 2 ^ (8 * (l.length + 1)) = 2 ^ (8 * l.length) * 256 := by
      rw [Nat.mul_add, Nat.pow_add]
    rw [hP]
    have h1 : BitVec.toNat b % (2 ^ (8 * l.length) * 256) = BitVec.toNat b :=
      Nat.mod_eq_of_lt (by omega)
    have h2 : a % (2 ^ (8 * l.length) * 256) = a := Nat.mod_eq_of_lt (by omega)
    have h3 : (a <<< 8) % (2 ^ (8 * l.length) * 256) = a <<< 8 :=
      Nat.mod_eq_of_lt (by rw [Nat.shiftLeft_eq]; omega)
    rw [h1, h2, h3, Nat.or_comm, ← Nat.shiftLeft_add_eq_or_of_lt hb, Nat.shiftLeft_eq]
    omega

/-- The EthLib reader (`readUint`), on exactly all the bytes, computes `leValue`. -/
theorem readUint_eq_leValue (data : Bytes) :
    readUint data 0 data.size = leValue UInt8.toNat data.toList := by
  have hv : (Vector.ofFn fun i : Fin data.size => data[0 + i.val]?.getD 0).toArray = data := by
    apply Array.ext (by simp)
    intro i h₁ h₂
    simp at h₁ ⊢
  rw [readUint, EthLib.Base.bytesToUint, hv, leValue, Array.foldr_toList]

/-- The Aeneas encoder (`BitVec.toLEBytes`, used by `uN::to_le_bytes`) writes the same bytes
as EthLib's `uintBytes`. -/
theorem toLEBytes_eq_uintBytes (k : Nat) :
    ∀ {w : Nat} (b : BitVec w), w = 8 * k →
      b.toLEBytes.map UInt8.ofBitVec = (uintBytes k b.toNat).toList := by
  induction k with
  | zero =>
    intro w b hw
    subst hw
    simp [BitVec.toLEBytes, uintBytes_zero]
  | succ k ih =>
    intro w b hw
    subst hw
    -- Both write the low byte and continue with `b / 256`, one byte narrower.
    rw [BitVec.toLEBytes]
    simp only [show 8 * (k + 1) > 0 by omega, ↓reduceIte]
    rw [List.map_cons, uintBytes_succ, Array.toList_append, ih _ (by omega)]
    have hb := b.isLt
    congr 1
    · apply UInt8.toNat_inj.mp
      simp [BitVec.toNat_setWidth]
    · congr 1
      rw [BitVec.toNat_setWidth, BitVec.toNat_ushiftRight, Nat.shiftRight_eq_div_pow]
      have : (2 : Nat) ^ (8 * (k + 1)) = 2 ^ 8 * 2 ^ (8 * (k + 1) - 8) := by
        rw [← Nat.pow_add]; congr 1; omega
      rw [this] at hb
      rw [Nat.mod_eq_of_lt (Nat.div_lt_of_lt_mul hb)]
      rfl

/-- leValue on a mapped list. -/
theorem leValue_map {α β : Type} (g : β → Nat) (h : α → β) (l : List α) :
    leValue g (l.map h) = leValue (g ∘ h) l := by
  induction l <;> simp_all [leValue]

/-- Rust bytes read by EthLib's `readUint`. -/
theorem readUint_bytes (l : List Std.U8) :
    readUint (bytes l) 0 l.length = leValue UScalar.val l := by
  rw [← bytes_size, readUint_eq_leValue, bytes, List.toList_toArray, leValue_map]
  rfl

/-- The bytes of `uN::to_le_bytes` as EthLib bytes. -/
theorem bytes_toLEBytes {w : Nat} (k : Nat) (b : BitVec w) (hw : w = 8 * k) :
    bytes (b.toLEBytes.map (@UScalar.mk UScalarTy.U8)) = uintBytes k b.toNat := by
  rw [bytes, List.map_map]
  have : (byte ∘ @UScalar.mk UScalarTy.U8) = UInt8.ofBitVec := rfl
  rw [this, toLEBytes_eq_uintBytes k b hw, Array.toArray_toList]

end Libssz.Proofs
